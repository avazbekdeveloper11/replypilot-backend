# Copy to .env for local development. In staging/prod these are injected by
# the deployment platform (K8s secrets / Vault), never committed.

APP_ENV=development
APP_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Dashboard's own base URL — used to build the password-reset link
# (WEB_APP_URL + /reset-password?token=...). Not a CORS setting.
WEB_APP_URL=http://localhost:3000

DB_HOST=localhost
DB_PORT=5432
DB_USER=replypilot
# Must match docker-compose.yml's postgres.environment.POSTGRES_PASSWORD
# for `make docker-up` to work out of the box — they're intentionally the
# same literal value, not a secret worth randomizing in a *.example file.
DB_PASSWORD=replypilot
DB_NAME=replypilot
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME_MIN=30

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Generate with: openssl rand -base64 48
JWT_SECRET=changeme-generate-a-real-secret
JWT_ISSUER=replypilot
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# From your Meta App dashboard (developers.facebook.com/apps)
META_APP_ID=changeme
META_APP_SECRET=changeme
# Points at the FRONTEND, not this API directly — Meta redirects the
# user's browser here after they authorize, and the frontend page at
# this route (web_app/replypilot-web/app/(dashboard)/instagram/callback)
# calls this API's public GET /v1/instagram/callback server-to-server to
# finish the exchange, then shows a real success/error UI instead of the
# API's raw JSON response. Must be registered EXACTLY as a valid OAuth
# redirect URI in the Meta App dashboard, including the path.
META_REDIRECT_URL=http://localhost:3000/instagram/callback
META_WEBHOOK_VERIFY_TOKEN=changeme-shared-secret-for-webhook-handshake
META_GRAPH_API_BASE_URL=https://graph.instagram.com

# 32-byte key for AES-256-GCM encryption of stored Instagram access tokens.
# Generate with: openssl rand -base64 32
# In production this should itself be wrapped by a KMS master key, not
# sourced directly from an env var — see pkg/crypto/aesgcm.go doc comment.
TOKEN_ENCRYPTION_KEY=changeme-32-bytes-exactly-000000

# amoCRM integration — optional (see AmoCRMConfig's doc comment, the
# service boots fine with these empty; connecting amoCRM just returns a
# clear error until they're set). One integration registered once at
# amocrm.ru -> Settings -> Integrations -> Create integration, shared
# across every org — not a per-org value. AMOCRM_REDIRECT_URL is the
# FRONTEND's callback page, same "frontend page proxies to this API's
# public callback endpoint" shape as META_REDIRECT_URL above — must be
# registered EXACTLY as the integration's redirect URI in amoCRM.
AMOCRM_CLIENT_ID=
AMOCRM_CLIENT_SECRET=
AMOCRM_REDIRECT_URL=http://localhost:3000/amocrm/callback

# Get a key at aistudio.google.com/apikey. Used for knowledge-base
# embeddings (text-embedding-004) and AI reply generation
# (gemini-2.0-flash). Left blank, those two features fail their own calls
# with a clear error — the rest of the API still boots and runs fine.
#
# This is only the BOOTSTRAP value — a platform admin can set/rotate the
# real key from the admin panel (Settings > Gemini API key) without
# touching this file or redeploying; see internal/platform/geminikey and
# README's "Platform settings" section. Once a key is set via the admin
# panel, it takes priority over whatever is here.
GEMINI_API_KEY=

# From your Stripe dashboard (dashboard.stripe.com/apikeys — use a test-mode
# key locally). STRIPE_WEBHOOK_SECRET is a DIFFERENT secret, generated when
# you create the webhook endpoint (dashboard.stripe.com/webhooks) pointing
# at POST /webhooks/stripe — not derived from the secret key. Left blank,
# billing endpoints fail their own calls with a clear error; the rest of
# the API still boots and runs fine.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

RATE_LIMIT_RPM=120
